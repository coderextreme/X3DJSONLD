procedure InitJoeDemo5JoeSkin5aPart300;
begin
{ So, the following interpolator: }
{ <OrientationInterpolator DEF='skullbase_RotationInterpolator' key='0 0.5 1' keyValue='0 0 1 0, 0 0 1 1, 0 0 1 0'/> }
{ will start at 0 move to +1 radian of z-axis }
{ rotation of the Joint, then return to 0. }
{ 0 0 1 0 is default value, meaning set to }
{ 0 radians = zero degrees }
{ 2pi radians = 360 degrees. }
{ form: x y z scale }
{ pitch, yaw, roll right hand rule }
{ in radians 0 to <+-inf. }
{ actual result = x y z per scale }
{ 1 0.5 -0.3 0.5 = 0.5x 0.25y -0.05z }
{ 1 radian = about 60 degrees }
{ 360 degrees divided by 2 times pi }
{ Right hand rule for axes so a }
{ positive roll value applied to the }
{ skullbase Joint would rotate the }
{ the gaze of model ccw toward the }
{ model&apos;s +X direction, the model left }
{ toward the left shoulder. }
TimeSensor3888 := TTimeSensorNode.Create;
TimeSensor3888.X3DName := 'Roll1Timer';
TimeSensor3888.CycleInterval := 10;
TimeSensor3888.Loop := True;
Group3887.FdChildren.Add(TimeSensor3888);
PositionInterpolator3889 := TPositionInterpolatorNode.Create;
PositionInterpolator3889.X3DName := 'Roll1_humanoid_root_TranslationInterpolator';
PositionInterpolator3889.SetKey([0, 0.02, 0.04, 0.06, 0.08, 0.1, 1]);
PositionInterpolator3889.SetKeyValue([Vector3(0, 0, 0), Vector3(0, 0, 0), Vector3(0, 0, 0.15), Vector3(0, 0, 0), Vector3(0, 0, -0.15), Vector3(0, 0, 0), Vector3(0, 0, 0)]);
Group3887.FdChildren.Add(PositionInterpolator3889);
OrientationInterpolator3890 := TOrientationInterpolatorNode.Create;
OrientationInterpolator3890.X3DName := 'Roll1_humanoid_root_RotationInterpolator';
OrientationInterpolator3890.SetKey([0, 0.08, 0.12, 0.15, 0.18, 0.2, 1]);
OrientationInterpolator3890.SetKeyValue([Vector4(0, 0, 1, 0), Vector4(0, 0, 1, 0), Vector4(0, 0, 1, 0.5), Vector4(0, 0, 1, 0), Vector4(0, 0, 1, -0.5), Vector4(0, 0, 1, 0), Vector4(0, 0, 1, 0)]);
Group3887.FdChildren.Add(OrientationInterpolator3890);
OrientationInterpolator3891 := TOrientationInterpolatorNode.Create;
OrientationInterpolator3891.X3DName := 'Roll1_sacroiliac_RotationInterpolator';
OrientationInterpolator3891.SetKey([0, 0.2, 0.25, 0.3, 0.35, 0.4, 1]);
