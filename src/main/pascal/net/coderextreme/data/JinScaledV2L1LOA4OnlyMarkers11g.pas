PositionInterpolator5095.SetKeyValue([Vector3(0, 0, 0), Vector3(0, 0, 0), Vector3(0, 0.15, 0), Vector3(0, 0, 0), Vector3(0, -0.15, 0), Vector3(0, 0, 0), Vector3(0, 0, 0)]);
