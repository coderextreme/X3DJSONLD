<![CDATA[castlescript:

{ CastleScript cannot call user-defined functions, only built-ins,
  so everything is inlined into the two event handlers. }

function initialize(timestamp)
  (
  translation := vector(0.0, 0.0, 0.0);
  velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)
  )

function set_fraction(value, timestamp)
  (
  { move, bouncing back to a fresh start when out of the +-10 box }
  translation := translation + velocity;
  j := 0;
  while(j < 3,
    (
    if(abs(vector_get(translation, 0)) > 10,
      (translation := vector(0.0, 0.0, 0.0);
         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),
    if(abs(vector_get(translation, 1)) > 10,
      (translation := vector(0.0, 0.0, 0.0);
         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),
    if(abs(vector_get(translation, 2)) > 10,
      (translation := vector(0.0, 0.0, 0.0);
         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),
      velocity := vector(
        vector_get(velocity, 0) + random() * 0.2 - 0.1,
        vector_get(velocity, 1) + random() * 0.2 - 0.1,
        vector_get(velocity, 2) + random() * 0.2 - 0.1))));
    j := j + 1
    )
  );

  { animate the shader parameters }
  choice := floor(random() * 4);
  if(choice = 0, a := a + random() * 0.2 - 0.1,
  if(choice = 1, b := b + random() * 0.2 - 0.1,
  if(choice = 2, c := c + random() * 2 - 1,
                 d := d + random() * 2 - 1)));
  tdelta := tdelta + 0.5;
  pdelta := pdelta + 0.5;
  when(a > 1, a := 0.5);
  when(b > 1, b := 0.5);
  when(c < 1, c := 4);
  when(d < 1, d := 4);
  when(c > 10, c := 4);
  when(d > 10, d := 4)
  )

]]>
          </Script>
	  <Script DEF='Animate'
              directOutput='true'>
            <field accessType='inputOutput' type='SFVec3f' name='translation'/>
            <field accessType='outputOnly' type='SFVec3f' name='velocity'/>
            <field accessType='inputOnly' type='SFFloat' name='set_fraction'/>
            <field accessType='outputOnly' type='SFFloat' name='a'/>
            <field accessType='outputOnly' type='SFFloat' name='b'/>
            <field accessType='outputOnly' type='SFFloat' name='c'/>
            <field accessType='outputOnly' type='SFFloat' name='d'/>
            <field accessType='outputOnly' type='SFFloat' name='tdelta'/>
            <field accessType='outputOnly' type='SFFloat' name='pdelta'/>
<![CDATA[
  
ecmascript:
			function initialize() {
			    translation = new SFVec3f(0, 0, 0);
			    velocity = new SFVec3f(
			    	Math.random() - 0.5,
				Math.random() - 0.5,
				Math.random() - 0.5);
			}
			function set_fraction() {
			    translation = new SFVec3f(
			    	translation.x + velocity.x,
				translation.y + velocity.y,
				translation.z + velocity.z);
			    for (var j = 0; j <= 2; j++) {
				    if (Math.abs(translation.x) > 10) {
					initialize();
				    } else if (Math.abs(translation.y) > 10) {
					initialize();
				    } else if (Math.abs(translation.z) > 10) {
					initialize();
				    } else {
					velocity.x += Math.random() * 0.2 - 0.1;
					velocity.y += Math.random() * 0.2 - 0.1;
					velocity.z += Math.random() * 0.2 - 0.1;
				    }
			    }
			    animate_flowers();
			}

			function animate_flowers(fraction, eventTime) {
				var choice = Math.floor(Math.random() * 4);
				switch (choice) {
				case 0:
					a += Math.random() * 0.2 - 0.1;
					break;
				case 1:
					b += Math.random() * 0.2 - 0.1;
					break;
				case 2:
					c += Math.random() * 2 - 1;
					break;
				case 3:
					d += Math.random() * 2 - 1;
					break;
				}
				tdelta += 0.5;
				pdelta += 0.5;
				if (a > 1) {
					a =  0.5;
				}
				if (b > 1) {
					b =  0.5;
				}
				if (c < 1) {
					c =  4;
				}
				if (d < 1) {
					d =  4;
				}
				if (c > 10) {
					c = 4;
				}
				if (d > 10) {
					d = 4;
				}
			}

]]>
          </Script>
          <TimeSensor DEF='TourTime'
              cycleInterval='5'
              loop='true'/>
        </Transform>
        <ROUTE fromNode='TourTime' fromField='fraction_changed' toNode='Animate' toField='set_fraction'/>
