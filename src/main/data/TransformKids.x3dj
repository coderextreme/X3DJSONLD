{ "X3D": {
    "encoding":"UTF-8",
    "@class":"x3dModel.class",
    "@profile":"Full",
    "@style":"x3dModel.style",
    "@version":"4.0",
    "@xsd:noNamespaceSchemaLocation":"https://www.web3d.org/specifications/x3d-4.0.xsd",
    "JSON schema":"https://www.web3d.org/specifications/x3d-4.0-JSONSchema.autogenerated.json",
    "head": {
        "component": [
          {
            "@name":"Grouping",
            "@level":1
          }
        ],
        "meta": [
          {
            "@name":"title",
            "@content":"SmokeTestProgramOutput.x3d"
          },
          {
            "@name":"info",
            "@content":"To Show Problems with X3dToJson.xslt"
          },
          {
            "@name":"description",
            "@content":"Example SmokeTestProgram creates an X3D model using the X3D Java Scene Access Interface Library (X3DJSAIL)"
          },
          {
            "@name":"created",
            "@content":"28 October 2026"
          },
          {
            "@name":"creator",
            "@content":"John Carlson"
          },
          {
            "@name":"refernce",
            "@content":"https://www.web3d.org/specifications/java/examples/SmokeTestProgram.java"
          },
          {
            "@name":"license",
            "@content":"../license.html"
          },
          {
            "@name":"translated",
            "@content":"28 October 2026"
          },
          {
            "@name":"generator",
            "@content":"X3dToJson.xslt, https://www.web3d.org/x3d/stylesheets/X3dToJson.html"
          },
          {
            "@name":"reference",
            "@content":"X3D JSON encoding: https://www.web3d.org/wiki/index.php/X3D_JSON_Encoding"
          }
        ]
    },
    "Scene": {
        "-children":[
          { "Transform":
            {
              "@translation":[0,1.5,0],
              "-children":[
                { "Shape":
                  {
                    "-appearance":
                      { "Appearance":
                        {
                          "-material":
                            { "Material":
                              {
                                "@DEF":"GreenMaterial",
                                "@diffuseColor":[0,1,0]
                              }
                            }
                        }
                      },
                    "-geometry":
                      { "Box":
                        {
                        }
                      }
                  }
                }
              ]
            }
          },
          { "MetadataSet":
            {
              "-value":[
                { "MetadataString":
                  {
                    "@value":["Metadata String"]
                  }
                }
              ]
            }
          },
          { "Transform":
            {
              "@translation":[0,-1.5,0],
              "-children":[
                { "Shape":
                  {
                    "-appearance":
                      { "Appearance":
                        {
                          "-material":
                            { "Material":
                              {
                                "@DEF":"RedMaterial",
                                "@diffuseColor":[1,0,0]
                              }
                            }
                        }
                      },
                    "-geometry":
                      { "Box":
                        {
                        }
                      }
                  }
                }
              ]
            }
          }
        ]
    }
  }
}