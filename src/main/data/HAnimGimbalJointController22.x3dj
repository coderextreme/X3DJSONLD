, b); } function ovIn2(b){ overBox(2, 0, b); } function ovTIn2(b){ overBox(2, 1, b); } function acSl2(b){ actCtl(2, b); } function acTSl2(b){ actCtl(2, b); } function acRg2(b){ actCtl(2, b); } function initialize() { log('controller initialize'); var children = []; for (var i = 0; i < names.length; i++) { ang[i] = [0,0,0]; children[i] = []; var p = parentName[i]; parentOf[i] = p ? names.indexOf(p) : -1; side[i] = names[i].indexOf('l_') == 0 ? 0 : (names[i].indexOf('r_') == 0 ? 1 : 2); } for (var i = 0; i < names.length; i++) { var p = parentOf[i]; if (p >= 0) children[p].push(i); } for (var i = 0; i < names.length; i++) { var kids = children[i]; nKids[i] = kids.length; firstChild[i] = kids.length > 0 ? kids[0] : -1; prevSib[i] = -1; nextSib[i] = -1; } for (var i = 0; i < names.length; i++) { var kids = children[i]; for (var k = 0; k < kids.length; k++) { var c = kids[k]; if (k > 0) prevSib[c] = kids[k - 1]; if (k < kids.length - 1) nextSib[c] = kids[k + 1]; } } try { initT(); } catch (e) { log('initT error: ' + e); } try { select(names.indexOf('l_shoulder')); } catch (e) { log('initialize error: ' + e); } try { a11yInit(); } catch (e) { log('a11y init error: ' + e); } } function rotX(v){ try { drag(0, v); } catch (e) { log('drag X error: ' + e); } } function rotY(v){ try { drag(1, v); } catch (e) { log('drag Y error: ' + e); } } function rotZ(v){ try { drag(2, v); } catch (e) { log('drag Z error: ' + e); } } function next(t){ try { earPress(); select(sel < 0 ? 0 : (sel + 1) % names.length); } catch (e) { log('next error: ' + e); } } function prev(t){ try { earPress(); select(sel < 0 ? names.length - 1 : (sel + names.length - 1) % names.length); } catch (e) { log('prev error: ' + e); } } function up(t){ try { earPress(); if (sel >= 0 && parentOf[sel] >= 0) select(parentOf[sel]); else earBlocked(sel < 0 ? 'No joint selected' : 'No parent, this is the root joint'); } catch (e) { log('up error: ' + e); } } function down(t){ try { earPress(); if (sel >= 0 && firstChild[sel] >= 0) select(firstChild[sel]); else earBlocked(sel < 0 ? 'No joint selected' : 'No child, this joint is a leaf'); } catch (e) { log('down error: ' + e); } } function sibPrev(t){ try { earPress(); if (sel >= 0 && prevSib[sel] >= 0) select(prevSib[sel]); else earBlocked(sel < 0 ? 'No joint selected' : 'No previous sibling'); } catch (e) { log('sibPrev error: ' + e); } } function sibNext(t){ try { earPress(); if (sel >= 0 && nextSib[sel] >= 0) select(nextSib[sel]); else earBlocked(sel < 0 ? 'No joint selected' : 'No next sibling'); } catch (e) { log('sibNext error: ' + e); } } function reset(t){ try { earPress(); if (sel >= 0) { ang[sel] = [0,0,0]; loadGimbal(); earSay('Joint reset to zero'); }; } catch (e) { log('reset error: ' + e); } } function deselect(t){ try { earPress(); clearSel(); } catch (e) { log('deselect error: ' + e); } } function pick_humanoid_root(t){ try { toggle(names.indexOf('humanoid_root')); } catch(e){} } function pick_sacroiliac(t){ try { toggle(names.indexOf('sacroiliac')); } catch(e){} } function pick_l_hip(t){ try { toggle(names.indexOf('l_hip')); } catch(e){} } function pick_l_knee(t){ try { toggle(names.indexOf('l_knee')); } catch(e){} } function pick_l_talocrural(t){ try { toggle(names.indexOf('l_talocrural')); } catch(e){} } function pick_l_talocalcaneonavicular(t){ try { toggle(names.indexOf('l_talocalcaneonavicular')); } catch(e){} } function pick_l_cuneonavicular_1(t){ try { toggle(names.indexOf('l_cuneonavicular_1')); } catch(e){} } function pick_l_tarsometatarsal_1(t){ try { toggle(names.indexOf('l_tarsometatarsal_1')); } catch(e){} } function pick_l_metatarsophalangeal_1(t){ try { toggle(names.indexOf('l_metatarsophalangeal_1')); } catch(e){} } function pick_l_tarsal_interphalangeal_1(t){ try { toggle(names.indexOf('l_tarsal_interphalangeal_1')); } catch(e){} } function pick_l_cuneonavicular_2(t){ try { toggle(names.indexOf('l_cuneonavicular_2')); } catch(e){} } function pick_l_tarsometatarsal_2(t){ try { toggle(names.indexOf('l_