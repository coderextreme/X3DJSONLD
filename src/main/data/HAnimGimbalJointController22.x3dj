| 'sine'; o.frequency.setValueAtTime(f, t0); g.gain.setValueAtTime(0.0001, t0); g.gain.exponentialRampToValueAtTime(Math.max(0.0002, v || 0.2), t0 + 0.008); g.gain.exponentialRampToValueAtTime(0.0001, t0 + d); o.connect(g); if (ac.createStereoPanner) { var p = ac.createStereoPanner(); p.pan.value = clamp(pan || 0, -1, 1); g.connect(p); p.connect(master); } else { g.connect(master); } o.start(t0); o.stop(t0 + d + 0.03); } catch (e) {} } function seq(freqs, step, type, vol, pan) { for (var i = 0; i < freqs.length; i++) beep(freqs[i], step * 1.4, type, vol, pan, i * step); } function pulses(n, f, type, vol, pan, delay) { for (var i = 0; i < n; i++) beep(f, 0.07, type, vol, pan, (delay || 0) + i * 0.13); } function thud(dir) { beep(70, 0.22, 'sine', 0.6, dir * 0.8); beep(140, 0.06, 'square', 0.12, dir * 0.8); } function errTone() { beep(150, 0.2, 'sawtooth', 0.15, 0); beep(110, 0.2, 'sawtooth', 0.15, 0, 0.12); } function trunc(s, n) { s = '' + s; return s.length > n ? s.substring(0, n - 1) + '...' : s; } function speak(msg) { try { var ss = window.speechSynthesis; if (!ss) return; ss.cancel(); var u = new SpeechSynthesisUtterance(msg); u.rate = 1.15; ss.speak(u); } catch (e) {} } function say(msg) { lastSay = '' + msg; showStatus(); try { if (live) { live.textContent = ''; setTimeout(function () { try { live.textContent = lastSay; } catch (e2) {} }, 40); } } catch (e) {} if (vox) speak(msg); } function clearSayTimer() { if (sayTimer) { clearTimeout(sayTimer); sayTimer = null; } } function sayLater(msg, ms) { clearSayTimer(); sayTimer = setTimeout(function () { sayTimer = null; say(msg); }, ms); } function earSay(msg) { if (a11yReady) say(msg); } function earBlocked(msg) { errTone(); say(msg); } function earPress() { if (a11yReady) beep(780, 0.05, 'square', 0.09, 0); } function showStatus() { try { var m = mode == 'J' ? 'JOINT' : (mode == 'R' ? 'ROTATE ' + AXN[kAx] : 'TRANSLATE ' + AXN[kAx]); statusText.string = new MFString('MODE ' + m + ' | H keys | sound ' + (snd ? 'on' : 'off') + ' voice ' + (vox ? 'on' : 'off'), trunc(lastSay, 62)); } catch (e) {} } function pretty(n) { var s = '' + n, m; if (s.indexOf('l_') == 0) s = 'left ' + s.substring(2); else if (s.indexOf('r_') == 0) s = 'right ' + s.substring(2); m = /^v([ctl])([0-9]+)$/.exec(s); if (m) return (m[1] == 'c' ? 'cervical' : (m[1] == 't' ? 'thoracic' : 'lumbar')) + ' vertebra ' + m[2]; return s.split('_').join(' '); } function sidePan(j) { return side[j] == 0 ? -0.8 : (side[j] == 1 ? 0.8 : 0); } function jointFreq(j) { return 262 * Math.pow(2, Math.min(depthOf[j] || 0, 18) / 9); } function jointPhrase(j) { var s = pretty(names[j]) + ', ' + (j + 1) + ' of ' + names.length; s += parentOf[j] >= 0 ? ', parent ' + pretty(names[parentOf[j]]) : ', root joint'; s += ', ' + nKids[j] + (nKids[j] == 1 ? ' child' : ' children'); return s; } function limitsPhrase(j) { var o = []; for (var k = 0; k < 3; k++) { var r = lim(joints[j], k); o.push(AXN[k] + (r ? ' ' + deg(r[0]) + ' to ' + deg(r[1]) : ' free')); } return 'limits in degrees: ' + o.join(', '); } function axisPhrase(k) { if (sel < 0) return 'no joint selected'; var r = lim(joints[sel], k); return fmt1(degf(ang[sel][k])) + ' degrees, ' + (r ? 'limits ' + deg(r[0]) + ' to ' + deg(r[1]) : 'free'); } function transPhrase(k) { return fmt3(getT()[k]) + ' meters'; } function axisSpeech() { return mode == 'T' ? AXN[kAx] + ' translation, ' + transPhrase(kAx) : AXN[kAx] + ' rotation, ' + axisPhrase(kAx); } function valueSpeech() { if (mode == 'T') return AXN[kAx] + ' ' + fmt3(getT()[kAx]) + ' meters'; return AXN[kAx] + ' ' + fmt1(degf(ang[sel][kAx])) + ' degrees'; } function hoverPaint(j, on) { try { if (on) { if (j == sel) return; mats[j].diffuseColor = new SFColor(1, 1, 1); mats[j].emissiveColor = new SFColor(0.75, 0.75, 0.75); var lm = lmatOf[names[j]]; if (lm) lm.emissiveColor = new SFColor(1, 1, 1); } else { paint(j, j == sel); } } catch (e) {} } function paintFocus() { try { for (var k = 0; k < 3; k++) { inMat[k].emissiveColor = (mode == 'R' && k == kAx && sel >= 0) ? new SFColor(0, 0.22, 0.35) : new SFColor(0, 0, 0); tinMat[k].emissiveColor = (mode == 'T' && k == kAx) ? new SFColor(0, 0.22, 0.35) : new SFColor(0, 0, 0); } } catch (e) {} } function a11ySync() { try { var typR = activeIn >= 0, typT = activeT >= 0; var wantR = domKeys ? false : typR, wantT = domKeys ? false : typT; if (strSens.enabled != wantR) strSens.enabled = wantR; if (strSensT.enabled != wantT) strSensT.enabled = wantT; } catch (e) {} paintFocus(); } function earSelect(j) { if (!a11yReady) return; var f = jointFreq(j), p = sidePan(j); beep(f, 0.09, 'triangle', 0.2, p); beep(f * 1.5, 0.12, 'triangle', 0.2, p, 0.09); say(jointPhrase(j) + ', selected'); } function earDeselect() { if (!a11yReady) return; beep(520, 0.08, 'triangle', 0.18, 0); beep(390, 0.12, 'triangle', 0.18, 0, 0.08); say('Joint deselected'); } function overJoint(j, b) { if (j < 0 || !a11yReady) return; if (b) { hoverJ = j; hoverPaint(j, true); var f = jointFreq(j), p = sidePan(j); beep(f, 0.06, 'sine', 0.15, p); if (j == sel) beep(f * 2, 0.05, 'sine', 0.1, p, 0.07); sayLater(pretty(names[j]) + (j == sel ? ', selected' : ''), 220); } else { if (hoverJ == j) hoverJ = -1; hoverPaint(j, false); clearSayTimer(); } } function overBtn(i, b) { if (!a11yReady) return; try { var m = btnMats[i]; if (b) { m.emissiveColor = new SFColor(0.35, 0.35, 0.65); m.diffuseColor = new SFColor(0.32, 0.32, 0.45); beep(540 + i * 14, 0.045, 'sine', 0.13, 0); sayLater(BTN[i] + ' button', 200); } else { m.emissiveColor = new SFColor(0.08, 0.08, 0.14); m.diffuseColor = new SFColor(0.2, 0.2, 0.28); clearSayTimer(); } } catch (e) {} } function knobGlow(idx, on) { try { var m = knobMats[idx]; m.emissiveColor = on ? new SFColor(0.95, 0.95, 0.95) : new SFColor(0.5, 0.1, 0.1); if (!on) { var k = idx % 3; if (k == 1) m.emissiveColor = new SFColor(0.1, 0.5, 0.1); if (k == 2) m.emissiveColor = new SFColor(0.15, 0.25, 0.5); } } catch (e) {} } function overSlider(k, grp, ring, b) { if (!a11yReady) return; if (b) { var d0 = grp == 1 ? 0.14 : 0; if (grp == 1) beep(82, 0.09, 'sine', 0.3, 0); pulses(k + 1, AXF[k], AXW[k], AXV[k], 0, d0); if (ring) pulses(k + 1, AXF[k] * 1.012, AXW[k], AXV[k] * 0.8, 0, d0); if (!ring) knobGlow(grp * 3 + k, true); var what = grp == 1 ? ' translation slider, ' + transPhrase(k) : (ring ? ' rotation ring, ' + axisPhrase(k) : ' rotation slider, ' + axisPhrase(k)); sayLater(AXN[k] + what, 200 + 130 * (k + 1) + d0 * 1000); } else { if (!ring) knobGlow(grp * 3 + k, false); clearSayTimer(); } } function overBox(k, grp, b) { if (!a11yReady) return; if (b) { beep(AXF[k] * 2, 0.05, 'sine', 0.1, 0); sayLater(AXN[k] + (grp == 1 ? ' translation input box, ' + transPhrase(k) : ' rotation input box, ' + (sel < 0 ? 'no joint selected' : fmt1(degf(ang[sel][k])) + ' degrees')) + '. Click to type a value', 260); } else { clearSayTimer(); } } function actCtl(k, b) { if (!a11yReady) return; if (b) beep(AXF[k] * 2, 0.03, 'square', 0.1, 0); else beep(AXF[k], 0.05, 'sine', 0.12, 0); } function moveCue(k, grp, old, a, lo, hi, src) { if (!a11yReady) return 0; var span = hi - lo, t = span > 0 ? clamp((a - lo) / span, 0, 1) : 0.5; var atMax = a >= hi - 0.000001, atMin = a <= lo + 0.000001; var wasMax = old >= hi - 0.000001, wasMin = old <= lo + 0.000001; var hit = atMax ? 1 : (atMin ? -1 : 0); if (hit != 0) { if (src == 'key' || (atMax && !wasMax) || (atMin && !wasMin)) thud(hit); return hit; } if ((old < 0 && a >= 0) || (old > 0 && a <= 0)) beep(1320, 0.04, 'square', 0.12, 2 * t - 1); var now = (new Date()).getTime(); if (now - lastMoveSnd > 45) { lastMoveSnd = now; beep(AXF[k] * Math.pow(2, t), 0.07, AXW[k], AXV[k], 2 * t - 1); } return 0; } function earMoveR(k, old, a, src) { var rg = range(k); return moveCue(k, 0, old, a, rg[0], rg[1], src); } function earMoveT(k, old, a, src) { return moveCue(k, 1, old, a, -TR, TR, src); } function charName(c) { if (c == '.') return 'point'; if (c == '-') return 'minus'; if (c == '+') return 'plus'; if (c == ' ') return 'space'; if (c == ',') return 'comma'; return c; } function earTypeStart(k, grp) { kAx = k; mode = grp == 0 ? 'R' : 'T'; lastTypedLen = 0; paintFocus(); if (!a11yReady) return; beep(900, 0.04, 'sine', 0.15, 0); beep(1200, 0.05, 'sine', 0.15, 0, 0.06); say('Typing ' + AXN[k] + (grp == 0 ? ' rotation in degrees' : ' translation in meters') + '. Type a number, then Enter. Enter on an empty box finishes. Escape cancels.'); } function earTypedKey(str) { if (!a11yReady) return; var s = '' + str, n = s.length; if (n > lastTypedLen) { beep(700 + n * 20, 0.025, 'square', 0.07, 0); speak(charName(s.charAt(n - 1))); } else { beep(300, 0.04, 'square', 0.08, 0); speak('deleted'); } lastTypedLen = n; } function earCommit(grp) { lastTypedLen = 0; if (!a11yReady) return; beep(660, 0.06, 'triangle', 0.18, 0); beep(990, 0.09, 'triangle', 0.18, 0, 0.07); var s = 'Applied. ', k; if (grp == 0) { var a = ang[sel]; s += 'X ' + fmt1(degf(a[0])) + ', Y ' + fmt1(degf(a[1])) + ', Z ' + fmt1(degf(a[2])) + ' degrees.'; k = activeIn; } else { var t = getT(); s += 'X ' + fmt3(t[0]) + ', Y ' + fmt3(t[1]) + ', Z ' + fmt3(t[2]) + ' meters.'; k = activeT; } if (k >= 0) { kAx = k; s += ' Now typing ' + AXN[k] + '.'; } say(s); } function earBad() { lastTypedLen = 0; if (!a11yReady) return; errTone(); say('That is not a number. Try again, or press Escape.'); } function consume(e) { try { e.preventDefault(); e.stopPropagation(); } catch (x) {} } function setMode(m) { if (m == 'R' && sel < 0) { earBlocked('Rotate mode needs a joint. Press N to select the first joint.'); return; } mode = m; if (m == 'J') seq([392, 523], 0.09, 'triangle', 0.2, 0); else if (m == 'R') seq([330, 415, 523], 0.08, 'triangle', 0.2, 0); else seq([523, 415, 330], 0.08, 'triangle', 0.2, 0); a11ySync(); if (m == 'J') say('Joint mode. Up arrow parent, down arrow child, left and right arrows siblings. N and P next and previous joint.'); else if (m == 'R') say('Rotate mode. ' + pretty(names[sel]) + '. Axis ' + axisSpeech() + '. Left and right arrows adjust.'); else say('Translate mode, humanoid root. Axis ' + axisSpeech() + '. Left and right arrows adjust.'); } function focusAxis(k) { kAx = (k + 3) % 3; a11ySync(); pulses(kAx + 1, AXF[kAx], AXW[kAx], AXV[kAx], 0); sayLater(axisSpeech(), 200 + 130 * (kAx + 1)); } function afterMove(hit) { sayLater(valueSpeech() + (hit > 0 ? ', maximum' : (hit < 0 ? ', minimum' : '')), 110); } function nudge(dir, mult) { var k = kAx, old, a, rg, hit; if (mode == 'R') { if (sel < 0) { earBlocked('No joint selected. Press N to select the first joint.'); return; } rg = range(k); old = ang[sel][k]; a = clamp(old + dir * (mult == 2 ? 10 : (mult == 0 ? 0.1 : 1)) * Math.PI / 180, rg[0], rg[1]); hit = earMoveR(k, old, a, 'key'); setAxis(k, a); applyJoint(); } else { old = getT()[k]; a = clamp(old + dir * (mult == 2 ? 0.1 : (mult == 0 ? 0.001 : 0.01)), -TR, TR); hit = earMoveT(k, old, a, 'key'); setT(k, a); syncT(); } afterMove(hit); } function jump(which) { var k = kAx, old, a, lo, hi, hit, rg; if (mode == 'R') { if (sel < 0) { earBlocked('No joint selected. Press N to select the first joint.'); return; } rg = range(k); lo = rg[0]; hi = rg[1]; old = ang[sel][k]; } else { lo = -TR; hi = TR; old = getT()[k]; } a = which == 'min' ? lo : (which == 'max' ? hi : clamp(0, lo, hi)); hit = mode == 'R' ? earMoveR(k, old, a, 'key') : earMoveT(k, old, a, 'key'); if (which == 'zero') beep(1320, 0.05, 'square', 0.12, 0); if (mode == 'R') { setAxis(k, a); applyJoint(); } else { setT(k, a); syncT(); } afterMove(hit); } function describe() { var s = 'Mode ' + (mode == 'J' ? 'joint' : (mode == 'R' ? 'rotate, axis ' + AXN[kAx] : 'translate, axis ' + AXN[kAx])) + '. '; if (sel < 0) s += 'No joint selected. '; else { var a = ang[sel]; s += jointPhrase(sel) + '. X ' + fmt1(degf(a[0])) + ', Y ' + fmt1(degf(a[1])) + ', Z ' + fmt1(degf(a[2])) + ' degrees. ' + limitsPhrase(sel) + '. '; } var t = getT(); s += 'Root position X ' + fmt3(t[0]) + ', Y ' + fmt3(t[1]) + ', Z ' + fmt3(t[2]) + ' meters.'; say(s); } function toggleHelp() { helpOn = !helpOn; try { helpSwitch.whichChoice = helpOn ? 0 : -1; } catch (e) {} if (helpOn) say('Keyboard help shown. J joint mode: arrows move to the parent, child and siblings. R rotate mode: X Y Z or up and down choose the axis, left and right adjust, shift for ten degrees, alt for a tenth, Home and End jump to the limits, zero zeroes the axis, Enter types a value. T translate mode moves the root. N and P select the next and previous joint. D deselects. E exports, L imports. M toggles sound, V toggles speech, I says where you are, Escape returns to joint mode.'); else say('Keyboard help hidden'); } function typingKey(e, key) { var r = activeIn >= 0; var buf = r ? typedBuf : typedBufT; if (key == 'Escape') { activeIn = -1; activeT = -1; typedBuf = ''; typedBufT = ''; lastTypedLen = 0; if (sel >= 0) syncUI(); syncT(); beep(300, 0.08, 'sine', 0.15, 0); say('Typing cancelled'); consume(e); return; } if (key == 'Enter') { consume(e); if (buf.length == 0) { activeIn = -1; activeT = -1; lastTypedLen = 0; if (sel >= 0) syncUI(); syncT(); beep(660, 0.06, 'triangle', 0.15, 0); say('Finished typing'); return; } if (r) typedFinalIn(buf); else typedFinalT_(buf); return; } if (key == 'Backspace') { buf = buf.substring(0, buf.length - 1); } else if (key.length == 1 && '0123456789.+-, rR'.indexOf(key) >= 0) { buf += key; } else { if (key.length == 1) consume(e); return; } consume(e); if (r) typedIn(buf); else typedT_(buf); } function onKey(e) { try { var tg = e.target, tn = (tg && tg.tagName) ? ('' + tg.tagName).toLowerCase() : ''; if (tn == 'input' || tn == 'textarea' || tn == 'select' || (tg && tg.isContentEditable)) return; if (e.ctrlKey || e.metaKey) return; actx(); var key = e.key; if (!key) return; if (activeIn >= 0 || activeT >= 0) { typingKey(e, key); return; } var mult = e.shiftKey ? 2 : (e.altKey ? 0 : 1); var low = key.length == 1 ? key.toLowerCase() : key; var axisMode = (mode == 'R' || mode == 'T'); switch (low) { case 'h': case '?': toggleHelp(); break; case 'i': describe(); break; case 'm': snd = !snd; if (snd) beep(660, 0.08, 'triangle', 0.2, 0); say(snd ? 'Sound on' : 'Sound off'); break; case 'v': if (vox) { say('Speech off'); vox = false; } else { vox = true; say('Speech on'); } showStatus(); break; case 'j': setMode('J'); break; case 'r': setMode('R'); break; case 't': setMode('T'); break; case 'Escape': if (helpOn) toggleHelp(); setMode('J'); break; case 'd': if (sel >= 0) clearSel(); else earBlocked('No joint selected'); break; case 'e': exportHumanoid(0); break; case 'l': importHumanoid(0); break; case 'n': case 'PageDown': next(0); break; case 'p': case 'PageUp': prev(0); break; case 'x': case 'y': case 'z': if (axisMode) focusAxis(low == 'x' ? 0 : (low == 'y' ? 1 : 2)); else earBlocked('Press R for rotate mode or T for translate mode first'); break; case 'ArrowUp': if (axisMode) focusAxis(kAx - 1); else up(0); break; case 'ArrowDown': if (axisMode) focusAxis(kAx + 1); else down(0); break; case 'ArrowLeft': if (axisMode) nudge(-1, mult); else sibPrev(0); break; case 'ArrowRight': if (axisMode) nudge(1, mult); else sibNext(0); break; case 'Home': if (axisMode) jump('min'); else select(0); break; case 'End': if (axisMode) jump('max'); else select(names.length - 1); break; case '0': if (axisMode) jump('zero'); else return; break; case 'Delete': case 'Backspace': if (mode == 'R') reset(0); else if (mode == 'T') resetT(0); else return; break; case 'Enter': case ' ': if (mode == 'R') { if (sel < 0) earBlocked('No joint selected'); else pickIn(kAx); } else if (mode == 'T') pickT(kAx); else describe(); break; default: return; } consume(e); } catch (x) { log('key error: ' + x); } } function a11yInit() { var i, d, p; for (i = 0; i < names.length; i++) { d = 0; p = parentOf[i]; while (p >= 0) { d++; p = parentOf[p]; } depthOf[i] = d; } try { live = document.createElement('div'); live.setAttribute('role', 'status'); live.setAttribute('aria-live', 'polite'); live.setAttribute('aria-atomic', 'true');