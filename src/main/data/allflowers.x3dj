                              "#sourceCode":[
"",
"castlescript:",
"",
"{ CastleScript cannot call user-defined functions, only built-ins,",
"  so everything is inlined into the two event handlers. }",
"",
"function initialize(timestamp)",
"  (",
"  translation := vector(0.0, 0.0, 0.0);",
"  velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)",
"  )",
"",
"function set_fraction(value, timestamp)",
"  (",
"  { move, bouncing back to a fresh start when out of the +-10 box }",
"  translation := translation + velocity;",
"  j := 0;",
"  while(j < 3,",
"    (",
"    if(abs(vector_get(translation, 0)) > 10,",
"      (translation := vector(0.0, 0.0, 0.0);",
"         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),",
"    if(abs(vector_get(translation, 1)) > 10,",
"      (translation := vector(0.0, 0.0, 0.0);",
"         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),",
"    if(abs(vector_get(translation, 2)) > 10,",
"      (translation := vector(0.0, 0.0, 0.0);",
"         velocity := vector(random() - 0.5, random() - 0.5, random() - 0.5)),",
"      velocity := vector(",
"        vector_get(velocity, 0) + random() * 0.2 - 0.1,",
"        vector_get(velocity, 1) + random() * 0.2 - 0.1,",
"        vector_get(velocity, 2) + random() * 0.2 - 0.1))));",
"    j := j + 1",
"    )",
"  );",
"",
"  { animate the shader parameters }",
"  choice := floor(random() * 4);",
"  if(choice = 0, a := a + random() * 0.2 - 0.1,",
"  if(choice = 1, b := b + random() * 0.2 - 0.1,",
"  if(choice = 2, c := c + random() * 2 - 1,",
"                 d := d + random() * 2 - 1)));",
"  tdelta := tdelta + 0.5;",
"  pdelta := pdelta + 0.5;",
"  when(a > 1, a := 0.5);",
"  when(b > 1, b := 0.5);",
"  when(c < 1, c := 4);",
"  when(d < 1, d := 4);",
"  when(c > 10, c := 4);",
"  when(d > 10, d := 4)",
"  )",
"",
"",
""
]
                            }
                          },
