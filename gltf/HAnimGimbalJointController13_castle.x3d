      when(sel = 96, (dif_l_carpometacarpal_1 := vector(1.0, 0.85, 0.1); emi_l_carpometacarpal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 97, (dif_l_metacarpophalangeal_1 := vector(1.0, 0.85, 0.1); emi_l_metacarpophalangeal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 98, (dif_l_carpal_interphalangeal_1 := vector(1.0, 0.85, 0.1); emi_l_carpal_interphalangeal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 99, (dif_l_midcarpal_2 := vector(1.0, 0.85, 0.1); emi_l_midcarpal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 100, (dif_l_carpometacarpal_2 := vector(1.0, 0.85, 0.1); emi_l_carpometacarpal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 101, (dif_l_metacarpophalangeal_2 := vector(1.0, 0.85, 0.1); emi_l_metacarpophalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 102, (dif_l_carpal_proximal_interphalangeal_2 := vector(1.0, 0.85, 0.1); emi_l_carpal_proximal_interphalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 103, (dif_l_carpal_distal_interphalangeal_2 := vector(1.0, 0.85, 0.1); emi_l_carpal_distal_interphalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 104, (dif_l_midcarpal_3 := vector(1.0, 0.85, 0.1); emi_l_midcarpal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 105, (dif_l_carpometacarpal_3 := vector(1.0, 0.85, 0.1); emi_l_carpometacarpal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 106, (dif_l_metacarpophalangeal_3 := vector(1.0, 0.85, 0.1); emi_l_metacarpophalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 107, (dif_l_carpal_proximal_interphalangeal_3 := vector(1.0, 0.85, 0.1); emi_l_carpal_proximal_interphalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 108, (dif_l_carpal_distal_interphalangeal_3 := vector(1.0, 0.85, 0.1); emi_l_carpal_distal_interphalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 109, (dif_l_midcarpal_4_5 := vector(1.0, 0.85, 0.1); emi_l_midcarpal_4_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 110, (dif_l_carpometacarpal_4 := vector(1.0, 0.85, 0.1); emi_l_carpometacarpal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 111, (dif_l_metacarpophalangeal_4 := vector(1.0, 0.85, 0.1); emi_l_metacarpophalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 112, (dif_l_carpal_proximal_interphalangeal_4 := vector(1.0, 0.85, 0.1); emi_l_carpal_proximal_interphalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 113, (dif_l_carpal_distal_interphalangeal_4 := vector(1.0, 0.85, 0.1); emi_l_carpal_distal_interphalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 114, (dif_l_carpometacarpal_5 := vector(1.0, 0.85, 0.1); emi_l_carpometacarpal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 115, (dif_l_metacarpophalangeal_5 := vector(1.0, 0.85, 0.1); emi_l_metacarpophalangeal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 116, (dif_l_carpal_proximal_interphalangeal_5 := vector(1.0, 0.85, 0.1); emi_l_carpal_proximal_interphalangeal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 117, (dif_l_carpal_distal_interphalangeal_5 := vector(1.0, 0.85, 0.1); emi_l_carpal_distal_interphalangeal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 118, (dif_r_sternoclavicular := vector(1.0, 0.85, 0.1); emi_r_sternoclavicular := vector(0.45, 0.38, 0.0)));
      when(sel = 119, (dif_r_acromioclavicular := vector(1.0, 0.85, 0.1); emi_r_acromioclavicular := vector(0.45, 0.38, 0.0)));
      when(sel = 120, (dif_r_shoulder := vector(1.0, 0.85, 0.1); emi_r_shoulder := vector(0.45, 0.38, 0.0)));
      when(sel = 121, (dif_r_elbow := vector(1.0, 0.85, 0.1); emi_r_elbow := vector(0.45, 0.38, 0.0)));
      when(sel = 122, (dif_r_radiocarpal := vector(1.0, 0.85, 0.1); emi_r_radiocarpal := vector(0.45, 0.38, 0.0)));
      when(sel = 123, (dif_r_midcarpal_1 := vector(1.0, 0.85, 0.1); emi_r_midcarpal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 124, (dif_r_carpometacarpal_1 := vector(1.0, 0.85, 0.1); emi_r_carpometacarpal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 125, (dif_r_metacarpophalangeal_1 := vector(1.0, 0.85, 0.1); emi_r_metacarpophalangeal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 126, (dif_r_carpal_interphalangeal_1 := vector(1.0, 0.85, 0.1); emi_r_carpal_interphalangeal_1 := vector(0.45, 0.38, 0.0)));
      when(sel = 127, (dif_r_midcarpal_2 := vector(1.0, 0.85, 0.1); emi_r_midcarpal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 128, (dif_r_carpometacarpal_2 := vector(1.0, 0.85, 0.1); emi_r_carpometacarpal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 129, (dif_r_metacarpophalangeal_2 := vector(1.0, 0.85, 0.1); emi_r_metacarpophalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 130, (dif_r_carpal_proximal_interphalangeal_2 := vector(1.0, 0.85, 0.1); emi_r_carpal_proximal_interphalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 131, (dif_r_carpal_distal_interphalangeal_2 := vector(1.0, 0.85, 0.1); emi_r_carpal_distal_interphalangeal_2 := vector(0.45, 0.38, 0.0)));
      when(sel = 132, (dif_r_midcarpal_3 := vector(1.0, 0.85, 0.1); emi_r_midcarpal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 133, (dif_r_carpometacarpal_3 := vector(1.0, 0.85, 0.1); emi_r_carpometacarpal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 134, (dif_r_metacarpophalangeal_3 := vector(1.0, 0.85, 0.1); emi_r_metacarpophalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 135, (dif_r_carpal_proximal_interphalangeal_3 := vector(1.0, 0.85, 0.1); emi_r_carpal_proximal_interphalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 136, (dif_r_carpal_distal_interphalangeal_3 := vector(1.0, 0.85, 0.1); emi_r_carpal_distal_interphalangeal_3 := vector(0.45, 0.38, 0.0)));
      when(sel = 137, (dif_r_midcarpal_4_5 := vector(1.0, 0.85, 0.1); emi_r_midcarpal_4_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 138, (dif_r_carpometacarpal_4 := vector(1.0, 0.85, 0.1); emi_r_carpometacarpal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 139, (dif_r_metacarpophalangeal_4 := vector(1.0, 0.85, 0.1); emi_r_metacarpophalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 140, (dif_r_carpal_proximal_interphalangeal_4 := vector(1.0, 0.85, 0.1); emi_r_carpal_proximal_interphalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 141, (dif_r_carpal_distal_interphalangeal_4 := vector(1.0, 0.85, 0.1); emi_r_carpal_distal_interphalangeal_4 := vector(0.45, 0.38, 0.0)));
      when(sel = 142, (dif_r_carpometacarpal_5 := vector(1.0, 0.85, 0.1); emi_r_carpometacarpal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 143, (dif_r_metacarpophalangeal_5 := vector(1.0, 0.85, 0.1); emi_r_metacarpophalangeal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 144, (dif_r_carpal_proximal_interphalangeal_5 := vector(1.0, 0.85, 0.1); emi_r_carpal_proximal_interphalangeal_5 := vector(0.45, 0.38, 0.0)));
      when(sel = 145, (dif_r_carpal_distal_interphalangeal_5 := vector(1.0, 0.85, 0.1); emi_r_carpal_distal_interphalangeal_5 := vector(0.45, 0.38, 0.0)));
      ix := 3 * sel + 0;
      limd := array_get(lo, ix) &lt;&gt; array_get(hi, ix);
      when(limd, array_set(ang, ix, max(array_get(lo, ix), min(array_get(hi, ix), array_get(ang, ix)))));
      ringMinX := if(limd, array_get(lo, ix), -6.28);
      ringMaxX := if(limd, array_get(hi, ix), 6.28);
      ringOffX := array_get(ang, ix);
      ringTrX := if(and(limd, array_get(hi, ix) - array_get(lo, ix) &lt; 0.04), 0.65, 0.0);
      ringXfX := vector(1.0, 0.0, 0.0, array_get(ang, ix));
      ix := 3 * sel + 1;
      limd := array_get(lo, ix) &lt;&gt; array_get(hi, ix);
      when(limd, array_set(ang, ix, max(array_get(lo, ix), min(array_get(hi, ix), array_get(ang, ix)))));
      ringMinY := if(limd, array_get(lo, ix), -6.28);
      ringMaxY := if(limd, array_get(hi, ix), 6.28);
      ringOffY := array_get(ang, ix);
      ringTrY := if(and(limd, array_get(hi, ix) - array_get(lo, ix) &lt; 0.04), 0.65, 0.0);
      ringXfY := vector(0.0, 1.0, 0.0, array_get(ang, ix));
      ix := 3 * sel + 2;
      limd := array_get(lo, ix) &lt;&gt; array_get(hi, ix);
      when(limd, array_set(ang, ix, max(array_get(lo, ix), min(array_get(hi, ix), array_get(ang, ix)))));
      ringMinZ := if(limd, array_get(lo, ix), -6.28);
      ringMaxZ := if(limd, array_get(hi, ix), 6.28);
      ringOffZ := array_get(ang, ix);
      ringTrZ := if(and(limd, array_get(hi, ix) - array_get(lo, ix) &lt; 0.04), 0.65, 0.0);
      ringXfZ := vector(0.0, 0.0, 1.0, array_get(ang, ix))
      ),
      (
      ringTrX := 0.65;
      ringXfX := vector(1.0, 0.0, 0.0, 0.0);
      ringTrY := 0.65;
      ringXfY := vector(0.0, 1.0, 0.0, 0.0);
      ringTrZ := 0.65;
      ringXfZ := vector(0.0, 0.0, 1.0, 0.0)
      )
    );
    reqApply := sel
  )

function doApply(value, timestamp)
  (
    label := if(value &lt; 0,
      array('GIMBAL', 'no joint selected', 'click a joint, or use NEXT'),
      array(
        array_get(title, array_get(side, value)) + ': ' + array_get(names, value) + '  (' + string(value + 1) + '/146)',
        'X ' + string(round((array_get(ang, 3 * value + 0)) * 180 / pi)) + '   ' + 'Y ' + string(round((array_get(ang, 3 * value + 1)) * 180 / pi)) + '   ' + 'Z ' + string(round((array_get(ang, 3 * value + 2)) * 180 / pi)) + '   ',
        'limits ' + if(array_get(lo, 3 * value + 0) &lt;&gt; array_get(hi, 3 * value + 0), 'X[' + string(round((array_get(lo, 3 * value + 0)) * 180 / pi)) + ',' + string(round((array_get(hi, 3 * value + 0)) * 180 / pi)) + '] ', 'X[free] ') + if(array_get(lo, 3 * value + 1) &lt;&gt; array_get(hi, 3 * value + 1), 'Y[' + string(round((array_get(lo, 3 * value + 1)) * 180 / pi)) + ',' + string(round((array_get(hi, 3 * value + 1)) * 180 / pi)) + '] ', 'Y[free] ') + if(array_get(lo, 3 * value + 2) &lt;&gt; array_get(hi, 3 * value + 2), 'Z[' + string(round((array_get(lo, 3 * value + 2)) * 180 / pi)) + ',' + string(round((array_get(hi, 3 * value + 2)) * 180 / pi)) + '] ', 'Z[free] '),
        'parent ' + if(array_get(parentOf, value) &gt;= 0, array_get(names, array_get(parentOf, value)), '-') + '   children ' + string(array_get(nKids, value))
      ));
    when(value &gt;= 0, (
      ta := array_get(ang, 3 * value) / 2.0;
      tb := array_get(ang, 3 * value + 1) / 2.0;
      tc := array_get(ang, 3 * value + 2) / 2.0;
      pw := cos(ta) * cos(tb);
      px := sin(ta) * cos(tb);
      py := cos(ta) * sin(tb);
      pz := sin(ta) * sin(tb);
      qw := pw * cos(tc) - pz * sin(tc);
      qx := px * cos(tc) + py * sin(tc);
      qy := py * cos(tc) - px * sin(tc);
      qz := pw * sin(tc) + pz * cos(tc);
      sa := sqrt(qx * qx + qy * qy + qz * qz);
      rq := if(sa &lt; 0.000001,
              vector(0.0, 0.0, 1.0, 0.0),
              vector(qx / sa, qy / sa, qz / sa, 2.0 * arccos(max(-1.0, min(1.0, qw)))));
      when(value = 0, rot_humanoid_root := rq);
      when(value = 1, rot_sacroiliac := rq);
      when(value = 2, rot_l_hip := rq);
      when(value = 3, rot_l_knee := rq);
      when(value = 4, rot_l_talocrural := rq);
      when(value = 5, rot_l_talocalcaneonavicular := rq);
      when(value = 6, rot_l_cuneonavicular_1 := rq);
      when(value = 7, rot_l_tarsometatarsal_1 := rq);
      when(value = 8, rot_l_metatarsophalangeal_1 := rq);
      when(value = 9, rot_l_tarsal_interphalangeal_1 := rq);
      when(value = 10, rot_l_cuneonavicular_2 := rq);
      when(value = 11, rot_l_tarsometatarsal_2 := rq);
      when(value = 12, rot_l_metatarsophalangeal_2 := rq);
      when(value = 13, rot_l_tarsal_proximal_interphalangeal_2 := rq);
      when(value = 14, rot_l_tarsal_distal_interphalangeal_2 := rq);
      when(value = 15, rot_l_cuneonavicular_3 := rq);
      when(value = 16, rot_l_tarsometatarsal_3 := rq);
      when(value = 17, rot_l_metatarsophalangeal_3 := rq);
      when(value = 18, rot_l_tarsal_proximal_interphalangeal_3 := rq);
      when(value = 19, rot_l_tarsal_distal_interphalangeal_3 := rq);
      when(value = 20, rot_l_calcaneocuboid := rq);
      when(value = 21, rot_l_transversetarsal := rq);
      when(value = 22, rot_l_tarsometatarsal_4 := rq);
      when(value = 23, rot_l_metatarsophalangeal_4 := rq);
      when(value = 24, rot_l_tarsal_proximal_interphalangeal_4 := rq);
      when(value = 25, rot_l_tarsal_distal_interphalangeal_4 := rq);
      when(value = 26, rot_l_tarsometatarsal_5 := rq);
      when(value = 27, rot_l_metatarsophalangeal_5 := rq);
      when(value = 28, rot_l_tarsal_proximal_interphalangeal_5 := rq);
      when(value = 29, rot_l_tarsal_distal_interphalangeal_5 := rq);
      when(value = 30, rot_r_hip := rq);
      when(value = 31, rot_r_knee := rq);
      when(value = 32, rot_r_talocrural := rq);
      when(value = 33, rot_r_talocalcaneonavicular := rq);
      when(value = 34, rot_r_cuneonavicular_1 := rq);
      when(value = 35, rot_r_tarsometatarsal_1 := rq);
      when(value = 36, rot_r_metatarsophalangeal_1 := rq);
      when(value = 37, rot_r_tarsal_interphalangeal_1 := rq);
      when(value = 38, rot_r_cuneonavicular_2 := rq);
      when(value = 39, rot_r_tarsometatarsal_2 := rq);
      when(value = 40, rot_r_metatarsophalangeal_2 := rq);
      when(value = 41, rot_r_tarsal_proximal_interphalangeal_2 := rq);
      when(value = 42, rot_r_tarsal_distal_interphalangeal_2 := rq);
      when(value = 43, rot_r_cuneonavicular_3 := rq);
      when(value = 44, rot_r_tarsometatarsal_3 := rq);
      when(value = 45, rot_r_metatarsophalangeal_3 := rq);
      when(value = 46, rot_r_tarsal_proximal_interphalangeal_3 := rq);
      when(value = 47, rot_r_tarsal_distal_interphalangeal_3 := rq);
      when(value = 48, rot_r_calcaneocuboid := rq);
      when(value = 49, rot_r_transversetarsal := rq);
      when(value = 50, rot_r_tarsometatarsal_4 := rq);
      when(value = 51, rot_r_metatarsophalangeal_4 := rq);
      when(value = 52, rot_r_tarsal_proximal_interphalangeal_4 := rq);
      when(value = 53, rot_r_tarsal_distal_interphalangeal_4 := rq);
      when(value = 54, rot_r_tarsometatarsal_5 := rq);
      when(value = 55, rot_r_metatarsophalangeal_5 := rq);
      when(value = 56, rot_r_tarsal_proximal_interphalangeal_5 := rq);
      when(value = 57, rot_r_tarsal_distal_interphalangeal_5 := rq);
      when(value = 58, rot_vl5 := rq);
      when(value = 59, rot_vl4 := rq);
