      when(sel = 83, (dif_l_eyelid_joint := vector(1.0, 0.85, 0.1); emi_l_eyelid_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 84, (dif_r_eyelid_joint := vector(1.0, 0.85, 0.1); emi_r_eyelid_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 85, (dif_l_eyeball_joint := vector(1.0, 0.85, 0.1); emi_l_eyeball_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 86, (dif_r_eyeball_joint := vector(1.0, 0.85, 0.1); emi_r_eyeball_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 87, (dif_l_eyebrow_joint := vector(1.0, 0.85, 0.1); emi_l_eyebrow_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 88, (dif_r_eyebrow_joint := vector(1.0, 0.85, 0.1); emi_r_eyebrow_joint := vector(0.45, 0.38, 0.0)));
      when(sel = 89, (dif_temporomandibular := vector(1.0, 0.85, 0.1); emi_temporomandibular := vector(0.45, 0.38, 0.0)));
      when(sel = 90, (dif_l_sternoclavicular := vector(1.0, 0.85, 0.1); emi_l_sternoclavicular := vector(0.45, 0.38, 0.0)));
      when(sel = 91, (dif_l_acromioclavicular := vector(1.0, 0.85, 0.1); emi_l_acromioclavicular := vector(0.45, 0.38, 0.0)));
      when(sel = 92, (dif_l_shoulder := vector(1.0, 0.85, 0.1); emi_l_shoulder := vector(0.45, 0.38, 0.0)));
      when(sel = 93, (dif_l_elbow := vector(1.0, 0.85, 0.1); emi_l_elbow := vector(0.45, 0.38, 0.0)));
      when(sel = 94, (dif_l_radiocarpal := vector(1.0, 0.85, 0.1); emi_l_radiocarpal := vector(0.45, 0.38, 0.0)));
