    <!-- ==================== SCRIPT CONTROLLER (CastleScript) ==================== -->
    <!-- Generated from the ecmascript controller. CastleScript cannot touch nodes, so every -->
    <!-- per-joint change leaves the script as an output event routed to the node below.     -->
    <Script DEF="controller" url="&quot;castlescript:
function initialize(timestamp)
  reqSelect := 92

function evNext(value, timestamp)
  reqSelect := if(sel &lt; 0, 0, if(sel + 1 &gt;= 146, 0, sel + 1))
function evPrev(value, timestamp)
  reqSelect := if(sel &lt;= 0, 145, sel - 1)
function evParent(value, timestamp)
  when(sel &gt;= 0, when(array_get(parentOf, sel) &gt;= 0, reqSelect := array_get(parentOf, sel)))
function evChild(value, timestamp)
  when(sel &gt;= 0, when(array_get(firstChild, sel) &gt;= 0, reqSelect := array_get(firstChild, sel)))
function evSibPrev(value, timestamp)
  when(sel &gt;= 0, when(array_get(prevSib, sel) &gt;= 0, reqSelect := array_get(prevSib, sel)))
function evSibNext(value, timestamp)
  when(sel &gt;= 0, when(array_get(nextSib, sel) &gt;= 0, reqSelect := array_get(nextSib, sel)))
function evReset(value, timestamp)
  when(sel &gt;= 0, (
    array_set(ang, 3 * sel, 0.0);
    array_set(ang, 3 * sel + 1, 0.0);
    array_set(ang, 3 * sel + 2, 0.0);
    reqSelect := sel
  ))
function evDeselect(value, timestamp)
  reqSelect := -1

function dragX(value, timestamp)
  when(sel &gt;= 0, (
    ta := if(vector_get(value, 0) + vector_get(value, 1) + vector_get(value, 2) &lt; 0, -1.0, 1.0) * vector_get(value, 3);
    ix := 3 * sel + 0;
    when(array_get(lo, ix) &lt;&gt; array_get(hi, ix), ta := max(array_get(lo, ix), min(array_get(hi, ix), ta)));
    array_set(ang, ix, ta);
    ringXfX := vector(1.0, 0.0, 0.0, ta);
    reqApply := sel
  ))

function dragY(value, timestamp)
  when(sel &gt;= 0, (
    ta := if(vector_get(value, 0) + vector_get(value, 1) + vector_get(value, 2) &lt; 0, -1.0, 1.0) * vector_get(value, 3);
    ix := 3 * sel + 1;
    when(array_get(lo, ix) &lt;&gt; array_get(hi, ix), ta := max(array_get(lo, ix), min(array_get(hi, ix), ta)));
    array_set(ang, ix, ta);
    ringXfY := vector(0.0, 1.0, 0.0, ta);
    reqApply := sel
  ))

function dragZ(value, timestamp)
  when(sel &gt;= 0, (
    ta := if(vector_get(value, 0) + vector_get(value, 1) + vector_get(value, 2) &lt; 0, -1.0, 1.0) * vector_get(value, 3);
    ix := 3 * sel + 2;
    when(array_get(lo, ix) &lt;&gt; array_get(hi, ix), ta := max(array_get(lo, ix), min(array_get(hi, ix), ta)));
    array_set(ang, ix, ta);
    ringXfZ := vector(0.0, 0.0, 1.0, ta);
    reqApply := sel
  ))

function doSelect(value, timestamp)
  (
    when(sel &gt;= 0, (
      when(sel = 0, (dif_humanoid_root := vector(0.4, 0.8, 0.4); emi_humanoid_root := vector(0.0, 0.0, 0.0)));
