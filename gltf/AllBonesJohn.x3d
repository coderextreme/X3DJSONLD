<X3D profile='Interactive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta content='AllBonesCollection.x3d' name='title'/>
    <meta content='AllBonesCollection shows a visual inventory of all bones in this directory, with model order corresponding to the HAnim Specification draft v2.1 Level of Articulation LOA5 diagram. No HAnimHumanoid, HAnimJoint or HAnimSegment nodes are included. This Inline collection confirms that each bone model is already positioned to match a default skeleton. To facilitate reuse, all model names match the HAnim specification, and all units are in meters.' name='description'/>
    <meta content='Don Brutzman, Joe Williams' name='creator'/>
    <meta content='15 March 2026' name='created'/>
    <meta content='17 October 2026' name='modified'/>
    <meta content='missing model: c1disc.x3d l_tarsal_distal_phalanx_5.x3d needs creation, but actual geometry appears to be included within l_tarsal_middle_phalanx_5.x3d' name='TODO'/>
    <meta content='add cartilage models' name='TODO'/>
    <meta content='AllBonesCollection.png' name='Image'/>
    <meta content='AllBonesCollectionX_ITE.png' name='Image'/>
    <meta content='https://en.wikipedia.org/wiki/Human_skeleton' name='reference'/>
    <meta content='X3D 4.0 Architecture, ISO/IEC 19775-1:202x draft version 4.1, clause 4 Concepts, section 4.11.6.6 LOA‑5 hierarchy' name='specificationSection'/>
    <meta content='https://www.web3d.org/specifications/X3Dv4Draft/ISO-IEC19774/ISO-IEC19774-1/ISO-IEC19774-1v2.1/ISO-IEC19774-1v2.1-WD/Architecture/concepts.html#Hierarchy5' name='specificationUrl'/>
    <meta content='usage examples https://www.web3d.org/x3d/content/examples/HumanoidAnimation/Medical' name='reference'/>
    <meta content='X3D-Edit 4.0, https://www.web3d.org/x3d/tools/X3D-Edit' name='generator'/>
    <meta content='X3D Tidy, https://www.web3d.org/x3d/stylesheets/X3dTidy.html' name='generator'/>
    <meta content='https://www.web3d.org/x3d/content/examples/HumanoidAnimation/Bones/AllBonesCollection.x3d' name='identifier'/>
    <meta content='../license.html' name='license'/>
  </head>
  <Scene>
    <WorldInfo title='AllBonesCollection.x3d'/>
    <Background skyColor='0.858824 1 0.94902'/>
    <!--
    <Transform scale='0.98 0.98 0.98' translation='0 0.88 0' visible='false'>
      <Inline description='hello skin!' url='"../Medical/BodySkinIndexedFaceSetNIST.x3d"'/>
    </Transform>
    -->
    <!-- vertical offset to max height of l_hip_bone -->
    <Transform DEF='AllBonesCollection' translation='0 0.9525 0'>
      <ViewpointGroup DEF='ViewpointGroup_AllBonesCollection' description='AllBonesCollection model' retainUserOffsets='true'>
        <Viewpoint DEF='ViewFromFront' description='AllBonesCollection from front' nearDistance='0.001' position='0 0 2.8' retainUserOffsets='true'/>
        <Viewpoint DEF='ViewFromBehind' description='AllBonesCollection from left side' nearDistance='0.001' orientation='0 1 0 1.5708' position='2.8 0 0' retainUserOffsets='true'/>
        <Viewpoint DEF='ViewFromLeft' description='AllBonesCollection from behind' nearDistance='0.001' orientation='0 1 0 3.1416' position='0 0 -2.8' retainUserOffsets='true'/>
        <Viewpoint DEF='ViewFromRight' description='AllBonesCollection from right side' nearDistance='0.001' orientation='0 1 0 -1.5708' position='-2.8 0 0' retainUserOffsets='true'/>
        <Viewpoint DEF='ViewFromAbove' description='AllBonesCollection from above' nearDistance='0.001' orientation='1 0 0 -1.5708' position='0 2.8 0' retainUserOffsets='true'/>
        <Viewpoint DEF='ViewFromBelow' description='AllBonesCollection from below' nearDistance='0.001' orientation='1 0 0 1.5708' position='0 -2.8 0' retainUserOffsets='true'/>
      </ViewpointGroup>
    </Transform>
