    <ROUTE fromField='touchTime' fromNode='Yaw_Touch' toField='set_stopTime' toNode='JumpTimer'/>
    <ROUTE fromField='touchTime' fromNode='Yaw_Touch' toField='set_stopTime' toNode='KickTimer'/>
    <ROUTE fromField='touchTime' fromNode='Yaw_Touch' toField='set_startTime' toNode='YawTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='DefaultTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='PitchTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='YawTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='RollTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='RunTimer'/>
