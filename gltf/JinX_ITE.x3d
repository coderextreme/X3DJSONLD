    <ROUTE fromField='touchTime' fromNode='Stand_Touch' toField='set_stopTime' toNode='KickTimer'/>
    <ROUTE fromField='touchTime' fromNode='Stand_Touch' toField='set_startTime' toNode='DefaultTimer'/>
    <ROUTE fromField='touchTime' fromNode='Pitch_Touch' toField='set_stopTime' toNode='DefaultTimer'/>
    <ROUTE fromField='touchTime' fromNode='Pitch_Touch' toField='set_stopTime' toNode='YawTimer'/>
