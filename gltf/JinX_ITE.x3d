    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_stopTime' toNode='KickTimer'/>
    <ROUTE fromField='touchTime' fromNode='Walk_Touch' toField='set_startTime' toNode='WalkTimer'/>
    <ROUTE fromField='touchTime' fromNode='Roll_Touch' toField='set_stopTime' toNode='DefaultTimer'/>
