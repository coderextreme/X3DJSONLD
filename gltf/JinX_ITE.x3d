    <ROUTE fromField='touchTime' fromNode='Yaw_Touch' toField='set_stopTime' toNode='PitchTimer'/>
    <ROUTE fromField='touchTime' fromNode='Yaw_Touch' toField='set_stopTime' toNode='RollTimer'/>
