    <ROUTE fromField='touchTime' fromNode='Pitch_Touch' toField='set_stopTime' toNode='KickTimer'/>
    <ROUTE fromField='touchTime' fromNode='Pitch_Touch' toField='set_startTime' toNode='PitchTimer'/>
