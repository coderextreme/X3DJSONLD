    <!-- ==================== GIMBAL SENSOR & BUTTON ROUTES ==================== -->
    <ROUTE fromNode="csGX" fromField="rotation_changed" toNode="controller" toField="rotX"/>
    <ROUTE fromNode="csGY" fromField="rotation_changed" toNode="controller" toField="rotY"/>
    <ROUTE fromNode="csGZ" fromField="rotation_changed" toNode="controller" toField="rotZ"/>
    <ROUTE fromNode="tsNext" fromField="touchTime" toNode="controller" toField="next"/>
    <ROUTE fromNode="tsPrev" fromField="touchTime" toNode="controller" toField="prev"/>
    <ROUTE fromNode="tsUp" fromField="touchTime" toNode="controller" toField="up"/>
    <ROUTE fromNode="tsDown" fromField="touchTime" toNode="controller" toField="down"/>
    <ROUTE fromNode="tsSibPrev" fromField="touchTime" toNode="controller" toField="sibPrev"/>
    <ROUTE fromNode="tsSibNext" fromField="touchTime" toNode="controller" toField="sibNext"/>
    <ROUTE fromNode="tsReset" fromField="touchTime" toNode="controller" toField="reset"/>
    <ROUTE fromNode="tsDeselect" fromField="touchTime" toNode="controller" toField="deselect"/>

