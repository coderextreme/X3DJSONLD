var side = [];
var parentOf = [];
var firstChild = [];
var nKids = [];
var prevSib = [];
var nextSib = [];
var title = ['LEFT','RIGHT','CENTER'];
var base = [[0.35,0.55,0.95],[0.95,0.45,0.35],[0.4,0.8,0.4]];
var sel = -1;
var ang = [];
var FREE = 6.28;
var dragLogged = false;

function log(m) { try { Browser.println('[gimbal] ' + m); } catch (e) {} }
function rotAbout(k, a, name) {
    log(name+'.rotation = SFRotation('+(k==0?1:0)+' '+(k==1?1:0)+' '+(k==2?1:0)+' '+a+');');
    return new SFRotation(k==0?1:0, k==1?1:0, k==2?1:0, a);
}
function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
function deg(r) { return Math.round(r*180/Math.PI); }
function lim(joint, k) {
  var l = joint.llimit, u = joint.ulimit;
  if (!l || !u || l.length &lt; 3 || u.length &lt; 3) return null;
  if (l[k] == u[k]) return null;
  return [l[k], u[k]];
}

function paint(j, on) {
  var m = mats[j], c = base[side[j]];
  if (on) { m.diffuseColor = new SFColor(1,0.85,0.1); m.emissiveColor = new SFColor(0.45,0.38,0); }
  else    { m.diffuseColor = new SFColor(c[0],c[1],c[2]); m.emissiveColor = new SFColor(0,0,0); }
}

function showLabel() {
  if (sel &lt; 0) { label.string = new MFString('GIMBAL', 'no joint selected', 'click a joint, or use NEXT'); syncUI(); return; }
  var a = ang[sel], s2 = '', s3 = '';
  for (var k = 0; k &lt; 3; k++) {
    var r = lim(joints[sel], k), n = 'XYZ'.charAt(k);
    s2 += n + ' ' + deg(a[k]) + '   ';
    s3 += n + (r ? '[' + deg(r[0]) + ',' + deg(r[1]) + ']' : '[free]') + ' ';
  }
  var s4 = 'parent ' + (parentOf[sel] &gt;= 0 ? names[parentOf[sel]] : '-') + '   children ' + nKids[sel];
  label.string = new MFString(title[side[sel]] + ': ' + names[sel] + '  (' + (sel + 1) + '/' + names.length + ')', s2, 'limits ' + s3, s4);
  syncUI();
}

function applyJoint() {
  var a = ang[sel];
  lastRot = rotAbout(0,a[0],names[sel]).multiply(rotAbout(1,a[1], names[sel])).multiply(rotAbout(2,a[2], names[sel]));
  joints[sel].rotation = lastRot;
  showLabel();
}

function loadGimbal() {
  var joint = joints[sel], info = '';
  for (var k = 0; k &lt; 3; k++) {
    try {
      var s = sensors[k], r = lim(joint, k), locked = false;
      if (r) {
        ang[sel][k] = clamp(ang[sel][k], r[0], r[1]);
        locked = (r[1] - r[0]) &lt; 0.04;
        s.minAngle = r[0]; s.maxAngle = r[1];
      } else {
        s.minAngle = -FREE; s.maxAngle = FREE;
      }
      s.offset = ang[sel][k];
      s.enabled = true;
      ringMat[k].transparency = locked ? 0.65 : 0;
      ringXf[k].rotation = rotAbout(k, ang[sel][k], names[sel]);
      info += 'XYZ'.charAt(k) + '[' + s.minAngle.toFixed(2) + ',' + s.maxAngle.toFixed(2) + ']' + (locked ? 'L ' : ' ');
    } catch (e) { log('loadGimbal axis ' + k + ' error: ' + e); }
  }
  log('rings ' + info);
  dragLogged = false;
  applyJoint();
}

function select(j) {
  if (sel &gt;= 0) paint(sel, false);
  sel = j;
  log('selected ' + names[j]);
  paint(j, true);
  loadGimbal();
}

function clearSel() {
  if (sel &gt;= 0) paint(sel, false);
  sel = -1;
  log('deselected');
  for (var k = 0; k &lt; 3; k++) {
    try {
      sensors[k].enabled = true;
      ringMat[k].transparency = 0.65;
      ringXf[k].rotation = rotAbout(k, 0, '');
    } catch (e) { log('clearSel axis ' + k + ' error: ' + e); }
  }
  showLabel();
}

function toggle(j) {
  if (j == sel) clearSel(); else select(j);
}

function drag(k, v) {
  if (sel &lt; 0) return;
  if (!dragLogged) { dragLogged = true; log('drag ' + 'XYZ'.charAt(k) + ' on ' + names[sel] + ' angle ' + v.angle); }
  var a = ((v.x + v.y + v.z) &lt; 0 ? -1 : 1) * v.angle;
  var r = lim(joints[sel], k);
  if (r) a = clamp(a, r[0], r[1]);
  ang[sel][k] = a;
  ringXf[k].rotation = rotAbout(k, a, names[sel]);
  applyJoint();
}

var lastRot = null;
var uiSrc = -1;
var activeIn = -1;
var typedBuf = '';
var SL = 0.75;

function fl(v) { var o = ''; for (var i = 0; i &lt; 3; i++) o += (i ? ' ' : '') + v[i].toFixed(4); return o; }
function degf(r) { return r * 180 / Math.PI; }
function fmt1(v) { return (Math.round(v * 10) / 10).toFixed(1); }
function range(k) {
  var r = lim(joints[sel], k);
  return r ? r : [-FREE, FREE];
}
function trim(s) {
  s = '' + s;
  while (s.length &gt; 0 &amp;&amp; s.charAt(0) == ' ') s = s.substring(1);
  while (s.length &gt; 0 &amp;&amp; s.charAt(s.length - 1) == ' ') s = s.substring(0, s.length - 1);
  return s;
}
function setAxis(k, a) {
  var rg = range(k);
  a = clamp(a, rg[0], rg[1]);
  ang[sel][k] = a;
  sensors[k].offset = a;
  ringXf[k].rotation = rotAbout(k, a, names[sel]);
}

function syncUI() {
  var k;
  if (sel &lt; 0) {
    for (k = 0; k &lt; 3; k++) {
      knobXf[k].translation = new SFVec3f(0, 0, 0);
      planeSens[k].offset = new SFVec3f(0, 0, 0);
      minTxt[k].string = new MFString('-');
      maxTxt[k].string = new MFString('-');
      inTxt[k].string = new MFString('-');
      inMat[k].diffuseColor = new SFColor(0.12, 0.12, 0.18);
    }
    outTxt.string = new MFString('OUTPUT', 'no joint selected', 'click a joint, or use NEXT');
    return;
  }
  var a = ang[sel], lines = [];
  for (k = 0; k &lt; 3; k++) {
    var r = lim(joints[sel], k), rg = range(k);
    var t = clamp((a[k] - rg[0]) / (rg[1] - rg[0]), 0, 1);
    var x = -SL + 2 * SL * t;
    knobXf[k].translation = new SFVec3f(x, 0, 0);
    if (k != uiSrc) planeSens[k].offset = new SFVec3f(x, 0, 0);
    minTxt[k].string = new MFString(r ? '' + deg(rg[0]) : '-360');
    maxTxt[k].string = new MFString(r ? '' + deg(rg[1]) : '360');
    if (k == activeIn) {
      inTxt[k].string = new MFString(typedBuf + '_');
      inMat[k].diffuseColor = new SFColor(0.5, 0.45, 0.1);
    } else {
      inTxt[k].string = new MFString(fmt1(degf(a[k])));
      inMat[k].diffuseColor = new SFColor(0.12, 0.12, 0.18);
    }
  }
  var q = lastRot;
  var rotStr = q ? (q.x.toFixed(4) + ' ' + q.y.toFixed(4) + ' ' + q.z.toFixed(4) + ' ' + q.angle.toFixed(4)) : '-';
  outTxt.string = new MFString(
    'OUTPUT ' + title[side[sel]] + ': ' + names[sel],
    'deg X ' + fmt1(degf(a[0])) + '  Y ' + fmt1(degf(a[1])) + '  Z ' + fmt1(degf(a[2])),
    'rad X ' + a[0].toFixed(3) + '  Y ' + a[1].toFixed(3) + '  Z ' + a[2].toFixed(3),
    'rotation ' + rotStr,
    'llimit ' + fl(joints[sel].llimit),
    'ulimit ' + fl(joints[sel].ulimit));
}

function slide(k, v) {
  if (sel &lt; 0) { syncUI(); return; }
  var rg = range(k);
  var t = clamp((v.x + SL) / (2 * SL), 0, 1);
  var a = rg[0] + t * (rg[1] - rg[0]);
  if (Math.abs(a - ang[sel][k]) &lt; 0.0001) return;
  setAxis(k, a);
  uiSrc = k;
  applyJoint();
  uiSrc = -1;
}

function pickIn(k) {
  if (sel &lt; 0) return;
  activeIn = k;
  typedBuf = '';
  syncUI();
}

function typedIn(str) {
  if (activeIn &lt; 0 || sel &lt; 0) return;
  typedBuf = '' + str;
  syncUI();
}

function parseAngle(tok) {
  tok = trim(tok);
  if (tok.length == 0) return NaN;
  var last = tok.charAt(tok.length - 1);
  var isRad = (last == 'r' || last == 'R');
  var v = parseFloat(tok);
  if (isNaN(v)) return NaN;
  return isRad ? v : v * Math.PI / 180;
}

function typedFinalIn(str) {
  if (activeIn &lt; 0 || sel &lt; 0) return;
  var s = trim(str).split(',').join(' ');
  var raw = s.split(' '), toks = [];
  for (var i = 0; i &lt; raw.length; i++) if (raw[i].length &gt; 0) toks.push(raw[i]);
  typedBuf = '';
  var k = activeIn;
  if (toks.length == 3) {
    var v = [parseAngle(toks[0]), parseAngle(toks[1]), parseAngle(toks[2])];
    if (!isNaN(v[0]) &amp;&amp; !isNaN(v[1]) &amp;&amp; !isNaN(v[2])) {
      for (var j = 0; j &lt; 3; j++) setAxis(j, v[j]);
      activeIn = -1;
      applyJoint();
      return;
    }
  } else if (toks.length == 1) {
    var a = parseAngle(toks[0]);
    if (!isNaN(a)) {
      setAxis(k, a);
      activeIn = (k + 1) % 3;
      applyJoint();
      return;
    }
  }
  syncUI();
}

function slideX(v){ try { slide(0, v); } catch (e) { log('slide X error: ' + e); } }
function slideY(v){ try { slide(1, v); } catch (e) { log('slide Y error: ' + e); } }
function slideZ(v){ try { slide(2, v); } catch (e) { log('slide Z error: ' + e); } }
function pickInX(t){ try { pickIn(0); } catch (e) { log('pickIn X error: ' + e); } }
function pickInY(t){ try { pickIn(1); } catch (e) { log('pickIn Y error: ' + e); } }
function pickInZ(t){ try { pickIn(2); } catch (e) { log('pickIn Z error: ' + e); } }
function typed(v){ try { typedIn(v); } catch (e) { log('typed error: ' + e); } }
function typedFinal(v){ try { typedFinalIn(v); } catch (e) { log('typedFinal error: ' + e); } }

function initialize() {
  log('controller initialize');
  var children = [];
  for (var i = 0; i &lt; names.length; i++) {
    ang[i] = [0,0,0];
    children[i] = [];
    var p = parentName[i];
    parentOf[i] = p ? names.indexOf(p) : -1;
    side[i] = names[i].indexOf('l_') == 0 ? 0 : (names[i].indexOf('r_') == 0 ? 1 : 2);
  }
  for (var i = 0; i &lt; names.length; i++) {
    var p = parentOf[i];
    if (p &gt;= 0) children[p].push(i);
  }
  for (var i = 0; i &lt; names.length; i++) {
    var kids = children[i];
    nKids[i] = kids.length;
    firstChild[i] = kids.length &gt; 0 ? kids[0] : -1;
    prevSib[i] = -1;
    nextSib[i] = -1;
  }
  for (var i = 0; i &lt; names.length; i++) {
    var kids = children[i];
    for (var k = 0; k &lt; kids.length; k++) {
      var c = kids[k];
      if (k &gt; 0) prevSib[c] = kids[k - 1];
      if (k &lt; kids.length - 1) nextSib[c] = kids[k + 1];
    }
  }
  try { select(names.indexOf('l_shoulder')); } catch (e) { log('initialize error: ' + e); }
}

function rotX(v){ try { drag(0, v); } catch (e) { log('drag X error: ' + e); } }
function rotY(v){ try { drag(1, v); } catch (e) { log('drag Y error: ' + e); } }
function rotZ(v){ try { drag(2, v); } catch (e) { log('drag Z error: ' + e); } }
function next(t){ try { select(sel &lt; 0 ? 0 : (sel + 1) % names.length); } catch (e) { log('next error: ' + e); } }
function prev(t){ try { select(sel &lt; 0 ? names.length - 1 : (sel + names.length - 1) % names.length); } catch (e) { log('prev error: ' + e); } }
function up(t){ try { if (sel &gt;= 0 &amp;&amp; parentOf[sel] &gt;= 0) select(parentOf[sel]); } catch (e) { log('up error: ' + e); } }
function down(t){ try { if (sel &gt;= 0 &amp;&amp; firstChild[sel] &gt;= 0) select(firstChild[sel]); } catch (e) { log('down error: ' + e); } }
function sibPrev(t){ try { if (sel &gt;= 0 &amp;&amp; prevSib[sel] &gt;= 0) select(prevSib[sel]); } catch (e) { log('sibPrev error: ' + e); } }
function sibNext(t){ try { if (sel &gt;= 0 &amp;&amp; nextSib[sel] &gt;= 0) select(nextSib[sel]); } catch (e) { log('sibNext error: ' + e); } }
function reset(t){ try { if (sel &gt;= 0) { ang[sel] = [0,0,0]; loadGimbal(); }; } catch (e) { log('reset error: ' + e); } }
function deselect(t){ try { clearSel(); } catch (e) { log('deselect error: ' + e); } }

