<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='HAnim' level='1'/>
    <meta name='title' content='HAnimGimbalJointController.x3d'/>
    <meta name='description' content='HAnim humanoid with one large gimbal that controls one joint at a time (left, right or center). Click a joint, or use PREV/NEXT, then drag the X/Y/Z rings. Rotation is clamped to each joint llimit/ulimit.'/>
  </head>
  <Scene>
    <!-- Joint colours: left = blue, right = red, center = green, selected = yellow.
         Ring colours: X = red, Y = green, Z = blue.  Faded ring = axis locked (llimit == ulimit). -->
    <NavigationInfo type='"NONE"' headlight='true'/>
    <Background skyColor='0.12 0.13 0.18'/>
    <Viewpoint description='Front' position='0.9 1.1 5.8'/>

